# 예시 값만 제공; 실제 비밀키는 Railway Variables 등에 저장
ADMIN_PASSWORD=
AUTH_SECRET=
# 관리자 계정별 API 세션 암호화 전용 키 (32자 이상). 최초 설정 후 변경하면 복호화가 불가능합니다.
CREDENTIAL_ENCRYPTION_KEY=
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 32자 이상의 임의 문자열. 관리자 서비스 및 워커에 동일하게 설정
TELEGRAM_BRIDGE_KEY=
# 허용할 비공개 테스트 그룹의 정확한 숫자형 ID, 쉼표 구분
TELEGRAM_ALLOWED_CHAT_IDS=
